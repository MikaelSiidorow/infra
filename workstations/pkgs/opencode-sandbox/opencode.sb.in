(version 1)
(deny default)
(import "system.sb")

(allow process*)
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup)

(allow file-read-metadata)
(allow file-read*
  (subpath "/System")
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/nix/store")
  (subpath "/nix/var/nix/profiles")
  (subpath "/run/current-system")
  (subpath "/dev")
  (subpath "/opt/homebrew")
  (subpath (param "WORKSPACE"))
  (subpath (param "TMPDIR"))
  (subpath (param "USER_PROFILE"))
  (subpath (param "OPENCODE_CONFIG"))
  (subpath (param "GIT_CONFIG_DIR"))
  (subpath (param "CLAUDE_SKILLS"))
  (subpath (param "OPENCODE_DATA"))
  (subpath (param "OPENCODE_STATE"))
  (subpath (param "OPENCODE_CACHE"))
  (subpath (param "BUN_HOME"))
  (subpath (param "PNPM_HOME"))
  (subpath (param "LOCAL_BIN"))
  (subpath (param "ORBSTACK_BIN"))
  (subpath (param "FNM_STATE"))
  (literal (param "ZSHENV"))
  (literal (param "ZPROFILE"))
  (literal (param "ZSHRC"))
  (literal (param "GIT_CONFIG"))
  (literal "/private/etc/bashrc")
  (literal "/private/etc/gitconfig")
  (literal "/private/etc/paths")
  (subpath "/private/etc/paths.d")
  (literal "/private/etc/ssl/openssl.cnf")
  (literal "/private/etc/zprofile")
  (literal "/private/etc/zshenv")
  (literal "/private/etc/zshrc"))

(allow file-write*
  (subpath (param "WORKSPACE"))
  (subpath (param "TMPDIR"))
  (subpath (param "OPENCODE_DATA"))
  (subpath (param "OPENCODE_STATE"))
  (subpath (param "OPENCODE_CACHE")))

(allow network-bind network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
